#!/usr/bin/env python3
"""Dispatcher for Claude Code's StopFailure(rate_limit) hook.

Launched by Claude Code when a response fails (rate_limit) due to a
session/usage limit. Since a hook is a short-lived subprocess, this script
**launches claude-resume detached in a visible terminal and returns immediately**.
By default it opens a new wt.exe (Windows Terminal) window that waits until the
reset and then **resumes the interactive TUI** via `claude --resume <id> "<prompt>"`
(the positional prompt is auto-sent as the first turn, so no manual typing is
needed; change the wording with env CLAUDE_RESUME_PROMPT, default
"Continue where you left off."). With `--approve` it asks y/N before the reset
is reached, and permission prompts also appear in that window, so it stays
observable.
There is no way to inject into an already-running session in Claude Code, so it
always spins up a fresh terminal.

Launch routes (forced by env CLAUDE_RESUME_LAUNCH, otherwise auto-detected):
  - window : new wt.exe window (default, recommended)
  - tmux   : detached tmux session (peek with `tmux attach -t claude-resume-<key>`)
  - headless: last resort when there is no TTY. Continues in the background as
    before with `claude --resume <id> -p "..."`.

This dispatcher only does the "wiring". Extracting the reset time and the
wait/retry policy are owned by claude-resume (it just passes the payload's
last_assistant_message = the limit text via `--reset-text`; the numeric knobs
are centralized in claude-resume's defaults).

Notes:
  - Comes with a duplicate-launch guard (a lock keyed by cwd+session). Young
    locks are honored via debounce, and since the waiting bash registers its own
    pid, back-to-back firings won't open a second window. The lock is released by
    the launcher's EXIT trap.
  - Artifacts are isolated under ~/.claude/limit-resume/: limit-resume.log (a
    record of hook firings), <key>.sh (launcher), <key>.out (launcher output;
    interactive output goes to the window/pane). Old .sh/.out are auto-deleted on
    startup.

To disable, just remove hooks.StopFailure from ~/.claude/settings.json.
The env var CLAUDE_RESUME_DISABLE=1 also disables it immediately.
Approval default / wait seconds: CLAUDE_RESUME_APPROVE_DEFAULT=yes|no /
CLAUDE_RESUME_APPROVE_TIMEOUT=seconds|none.
"""

from __future__ import annotations

import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

CLAUDE_DIR = Path.home() / ".claude"
# Isolate the resume launcher's temp files (.sh/.out) and log in this
# subdirectory so they don't clutter ~/.claude itself. .sh/.out files older than
# this many days are auto-deleted at runtime.
RESUME_DIR = CLAUDE_DIR / "limit-resume"
LOG = RESUME_DIR / "limit-resume.log"
ARTIFACT_TTL_DAYS = 7
RESUME_PROMPT = os.environ.get("CLAUDE_RESUME_PROMPT", "Continue where you left off.")

# A visible window (wt.exe->wsl->bash) takes a few seconds to spawn, during which
# the pid liveness check is blind until the script writes its own pid back to the
# lock. To avoid opening a second window on StopFailures that fire within the same
# second, a lock younger than this many seconds is treated as "still active"
# regardless of pid liveness.
LOCK_DEBOUNCE_SECONDS = 15.0


def log(msg: str) -> None:
    try:
        RESUME_DIR.mkdir(parents=True, exist_ok=True)
        with LOG.open("a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")
    except OSError:
        pass


def prune_artifacts() -> None:
    """Delete .sh/.out files in RESUME_DIR older than ARTIFACT_TTL_DAYS.
    Logs (.log) are exempt. Failures never stop the hook itself."""
    try:
        cutoff = time.time() - ARTIFACT_TTL_DAYS * 86400
        for f in RESUME_DIR.glob("*.sh"):
            if f.stat().st_mtime < cutoff:
                f.unlink(missing_ok=True)
        for f in RESUME_DIR.glob("*.out"):
            if f.stat().st_mtime < cutoff:
                f.unlink(missing_ok=True)
    except OSError:
        pass


def _resume_bin() -> str:
    """Resolve the claude-resume executable (only when called, so we don't scan
    PATH when disabled / duplicate-suppressed)."""
    return os.environ.get("CLAUDE_RESUME_BIN") or shutil.which("claude-resume") or str(
        Path.home() / ".local/bin/claude-resume"
    )


def _pid_alive(pid: int) -> bool:
    """Whether the process for pid is alive (checked via signal 0)."""
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:  # exists but no permission = alive
        return True
    return True


def acquire_lock(lock: Path) -> bool:
    """Atomically acquire the duplicate-launch guard lock. Returns True if acquired.

    - Created atomically with O_EXCL (avoids the TOCTOU between checking existence
      and creating).
    - An existing lock is treated as active and suppressed (False) if the pid
      inside it is **alive**. The primary check is pid liveness: it stays valid
      even for long waits as long as the process lives, and if the process is dead
      (stale from a crash/reboot/kill) the lock is taken over.
    - However, launching a visible window takes a few seconds to spawn, during
      which the pid is briefly blank until the waiting process writes its own pid
      back. To avoid opening a second window on back-to-back firings in that gap,
      a lock **younger than `LOCK_DEBOUNCE_SECONDS` is respected regardless of pid
      liveness** (pid check primary, time debounce as a secondary safety net).
    """
    try:
        fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
    except FileExistsError:
        holder = 0
        try:
            holder = int(lock.read_text().strip() or "0")
        except (OSError, ValueError):
            holder = 0
        if _pid_alive(holder):
            return False
        # Guard against back-to-back firings right after launch: respect a young
        # lock regardless of pid liveness (don't steal a launcher pid that died
        # before registering its own pid due to the visible-window spawn delay).
        try:
            age = time.time() - lock.stat().st_mtime
        except OSError:
            age = float("inf")
        if age < LOCK_DEBOUNCE_SECONDS:
            return False
        try:  # take over the stale lock
            lock.unlink()
            fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
        except (OSError, FileExistsError):
            return False
    # Write the hook's own pid first (the continuation process pid overwrites it
    # after launch).
    try:
        os.write(fd, str(os.getpid()).encode())
    finally:
        os.close(fd)
    return True


def resolve_launch_mode() -> str:
    """Which route to launch the resume through: window | tmux | headless.

    Forced by env CLAUDE_RESUME_LAUNCH. Otherwise auto-detected from what is
    available (visible window wt.exe -> tmux -> headless as last resort).
    """
    forced = os.environ.get("CLAUDE_RESUME_LAUNCH", "").strip().lower()
    if forced in ("window", "tmux", "headless"):
        return forced
    if shutil.which("wt.exe"):
        return "window"
    if shutil.which("tmux"):
        return "tmux"
    return "headless"


def build_commands(mode: str, claude_bin: str, session_id: str, reset_text: str = "") -> list[str]:
    """Build the resume_cmd passed to claude-resume.

    - window/tmux: **interactive** resume (no `-p`) plus `--approve --interactive`
      (wait until reset in a visible terminal, y/N, then resume the interactive
      TUI; permission prompts also appear in that window).
    - headless: headless continuation with `-p` as before (last resort when there
      is no TTY).
    If reset_text (the payload's last_assistant_message = the limit text) is
    present, pass it via `--reset-text` = the only source claude-resume has for
    working out the reset time (the transcript keeps no limit line).
    """
    base = [claude_bin, "--resume", session_id] if session_id else [claude_bin, "--continue"]
    if mode == "headless":
        inner = base + ["-p", RESUME_PROMPT]
        resume_cmd = [_resume_bin(), "--claude-bin", claude_bin, "--resume-prompt", RESUME_PROMPT]
    else:
        # Even in interactive mode the positional prompt is auto-sent as the first
        # turn = the moment the window opens, "continue" is submitted (no typing).
        inner = base + [RESUME_PROMPT]
        resume_cmd = [_resume_bin(), "--claude-bin", claude_bin, "--approve", "--interactive"]
    if reset_text:
        resume_cmd += ["--reset-text", reset_text]
    return resume_cmd + ["--", *inner]


def opener_argv(mode: str, key: str, script: Path) -> list[str]:
    """The argv that opens the launcher script in a visible terminal / background."""
    s = str(script)
    if mode == "window":
        # wt.exe opens a new window, and inside it wsl->bash runs the script.
        return ["wt.exe", "wsl.exe", "-e", "bash", s]
    if mode == "tmux":
        # Detached tmux session. Peek with `tmux attach -t claude-resume-<key>`.
        return ["tmux", "new-session", "-d", "-s", f"claude-resume-{key}", "bash", s]
    return ["bash", s]


def write_launcher(script: Path, cwd: str, lock: Path, resume_cmd: list[str]) -> None:
    """Write a launcher script that runs: cd -> register own pid to the lock -> resume_cmd.

    Does not use exec (exec would replace the shell, discarding the EXIT trap and
    leaving the lock behind). Registering its own pid lets duplicate-launch be
    judged by the liveness of the **bash that keeps waiting**, not the short-lived
    pid of the launcher (wt.exe, etc.).
    """
    lock_q = shlex.quote(str(lock))
    cwd_q = shlex.quote(cwd)
    body = "\n".join(
        [
            "#!/usr/bin/env bash",
            f"trap 'rm -f {lock_q}' EXIT",
            f"cd {cwd_q} || exit 1",
            f"echo $$ > {lock_q}",
            shlex.join(resume_cmd),
            "",
        ]
    )
    script.write_text(body, encoding="utf-8")
    script.chmod(0o755)


def main() -> int:
    if os.environ.get("CLAUDE_RESUME_DISABLE") == "1":
        return 0

    dry = "--dry" in sys.argv[1:]
    raw = sys.stdin.read() if not sys.stdin.isatty() else ""
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        payload = {}
    log(f"StopFailure fired. payload={raw.strip()[:600]}")
    prune_artifacts()

    cwd = str(payload.get("cwd") or os.getcwd())
    if not os.path.isdir(cwd):  # safeguard in case the payload's cwd is gone
        log(f"cwd={cwd} does not exist; falling back to {os.getcwd()}.")
        cwd = os.getcwd()
    session_id = str(payload.get("session_id") or "")
    # The limit text itself. claude-resume works out the reset time from this
    # (the transcript keeps no copy of it).
    reset_text = str(payload.get("last_assistant_message") or "")

    key = hashlib.sha1(f"{cwd}|{session_id}".encode()).hexdigest()[:12]
    lock = Path(f"/tmp/claude-resume-{key}.lock")

    claude_bin = shutil.which("claude") or "claude"
    mode = resolve_launch_mode()
    resume_cmd = build_commands(mode, claude_bin, session_id, reset_text)
    script = RESUME_DIR / f"{key}.sh"
    opener = opener_argv(mode, key, script)

    if dry:
        log(f"[dry] mode={mode} would launch: cwd={cwd} opener={opener} resume_cmd={resume_cmd}")
        print(json.dumps(
            {"mode": mode, "would_run": opener, "resume_cmd": resume_cmd, "cwd": cwd},
            ensure_ascii=False,
        ))
        return 0

    # Atomically acquire the duplicate-launch guard (suppressed if a live pid or a
    # young lock is present).
    if not acquire_lock(lock):
        log(f"Lock present ({lock}). Assuming a continuation process is already running; suppressing duplicate launch.")
        return 0

    # Drop cd -> register own pid -> resume_cmd into a launcher script and open it
    # in a visible terminal / background.
    write_launcher(script, cwd, lock, resume_cmd)
    bgout = RESUME_DIR / f"{key}.out"
    log(f"launch: mode={mode} cwd={cwd} session={session_id or '(continue)'} opener={opener}")
    try:
        with bgout.open("a", encoding="utf-8") as out:
            proc = subprocess.Popen(
                opener,
                cwd=cwd,
                stdin=subprocess.DEVNULL,
                stdout=out,          # for launcher (wt.exe/tmux) chatter; interactive output goes to the window/pane
                stderr=subprocess.STDOUT,
                start_new_session=True,  # detach (not taken down when the parent hook exits)
            )
    except OSError as exc:
        lock.unlink(missing_ok=True)
        log(f"launch failed: {exc}")
        return 0  # the hook swallows failures (non-blocking)
    # Record the launcher's pid first (together with the young-lock debounce, this
    # suppresses back-to-back firings). The bash that keeps waiting overwrites this
    # with its own pid after launch (the echo $$ in write_launcher).
    try:
        lock.write_text(str(proc.pid), encoding="utf-8")
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
